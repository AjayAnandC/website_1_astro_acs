# Example environment variables for local development
DATABASE_URL=sqlite:///./dev.db
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use either FIREBASE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FRONTEND_ORIGINS=https://www.astroacs.com,https://astroacs.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For production with Postgres: postgres://user:pass@host:5432/dbname
